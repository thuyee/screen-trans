<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Thanh trên: ★ Đã lưu · [Dịch màn hình] | tiêu đề + Nâng cao | menu -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <ImageButton
            android:id="@+id/btnSaved"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/saved_phrases"
            android:src="@drawable/ic_star" />
            <ImageButton
            android:id="@+id/btnScreen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/screen_toggle"
            android:src="@drawable/ic_translate" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAdvanced"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_adv"
                android:minWidth="120dp"
                android:gravity="center"
                android:paddingStart="22dp"
                android:paddingTop="10dp"
                android:paddingEnd="22dp"
                android:paddingBottom="10dp"
                android:text="@string/advanced"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="@string/menu_more"
            android:src="@drawable/ic_menu" />
    </FrameLayout>

    <!-- Khung nhập + kết quả (bo tròn góc dưới như Google Dịch) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_panel">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp">

                <EditText
                    android:id="@+id/input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="48dp"
                    android:autofillHints="no"
                    android:background="@null"
                    android:gravity="top"
                    android:hint="@string/text_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="@color/hint_text"
                    android:textSize="32sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDetected"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/hint_text"
                        android:textSize="14sp" />

                    <ImageButton
                android:id="@+id/btnSpeakIn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/speak"
                android:src="@drawable/ic_volume" />
                    <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clear"
                android:src="@drawable/ic_close" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/resultBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/output"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorPrimary"
                        android:textIsSelectable="true"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/romanization"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/hint_text"
                        android:textIsSelectable="true"
                        android:textSize="16sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textIsSelectable="true"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <ImageButton
                android:id="@+id/btnFull"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/fullscreen"
                android:src="@drawable/ic_fullscreen" />
                        <ImageButton
                android:id="@+id/btnCopy"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/copy"
                android:src="@drawable/ic_copy" />
                        <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/share"
                android:src="@drawable/ic_share" />
                        <ImageButton
                android:id="@+id/btnSpeak"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/speak"
                android:src="@drawable/ic_volume" />
                        <ImageButton
                android:id="@+id/btnStar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/saved_phrases"
                android:src="@drawable/ic_star_border" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/recentTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/recent"
                    android:textColor="@color/hint_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/recentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-16dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- Nút viết tay ở góc trên bên phải khung -->
        <ImageButton
            android:id="@+id/btnHand"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/handwriting"
            android:src="@drawable/ic_pen" />

        <View
            android:layout_width="52dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_handle" />
    </FrameLayout>

    <!-- Chọn ngôn ngữ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSrc"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSwap"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/swap"
            android:src="@drawable/ic_swap" />

        <TextView
            android:id="@+id/btnDst"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hàng dưới: Dịch trực tiếp · Micro · Máy ảnh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnLive"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_circle_side"
                android:contentDescription="@string/"
                android:src="@drawable/ic_chat"
                android:tint="@color/side_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/"
                android:textColor="@color/side_label"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:background="@drawable/bg_circle_mic"
            android:contentDescription="@string/voice_input"
            android:src="@drawable/ic_mic"
            android:tint="@color/mic_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnCamera"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_circle_side"
                android:contentDescription="@string/"
                android:src="@drawable/ic_camera"
                android:tint="@color/side_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/"
                android:textColor="@color/side_label"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
